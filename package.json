{
  "name": "question-paper-shuffler",
  "version": "1.0.0",
  "private": true,
  "description": "Generate multiple shuffled sets of a NEET-style Word question paper, with a matching answer key per set.",
  "author": "Jha Classes",
  "main": "dist/main/main.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "fix:electron": "node scripts/fix-electron.mjs",
    "icon": "node scripts/make-icon.mjs",
    "pack": "npm run build && npm run icon && electron-builder --win --dir",
    "portable": "npm run pack && node scripts/portable-zip.mjs",
    "dist": "npm run build && npm run icon && electron-builder --win",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "start": "npm run build && electron .",
    "cli": "npm run build:main && node dist/cli/cli.js",
    "regress": "npm run build:main && node scripts/regress.mjs",
    "audit": "npm run build:main && node scripts/audit-report.mjs",
    "ui:harness": "npm run build && node scripts/ui-harness.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.8",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
